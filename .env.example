# Copie este arquivo para ".env" e ajuste os valores conforme necessario.
# Nenhuma variavel e obrigatoria: se omitidas, valores padrao seguros sao usados.

# Porta em que o servidor vai rodar
PORT=3000

# Segredo usado para assinar os cookies de sessao (login).
# Se nao definido, um segredo aleatorio e gerado automaticamente e salvo em data/session.secret
# SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Pasta onde o banco de dados (ponto.db) e salvo. Por padrao usa a pasta "data"
# dentro do proprio projeto. Em hospedagens com disco persistente (ex.: Render),
# defina aqui o caminho onde o disco esta montado (ex.: /var/data) para que os
# dados sobrevivam a reinicios e novos deploys.
# DATA_DIR=/var/data

# Dados do administrador criado automaticamente na primeira execucao
# (so tem efeito se o banco de dados ainda nao tiver nenhum colaborador cadastrado)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@planosemeador.com.br
ADMIN_SENHA=semeador2026

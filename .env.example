# Copie este arquivo para ".env" e ajuste os valores conforme necessario.

# Porta em que o servidor vai rodar
PORT=3000

# Connection string do banco de dados Postgres. OBRIGATORIA (o servidor nao
# inicia sem ela). Pode ser um banco gratuito criado em https://neon.tech,
# https://supabase.com, um Postgres do proprio Render, ou qualquer outro.
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=

# Segredo usado para assinar os cookies de sessao (login).
# Se nao definido, um segredo aleatorio e gerado automaticamente e salvo em
# disco (pasta "data"). Em hospedagens SEM disco persistente (ex.: Render no
# plano Free), esse arquivo se perde a cada reinicio/novo deploy e todo mundo
# e deslogado — por isso, em producao, defina SESSION_SECRET explicitamente
# (um texto longo e aleatorio) para que as sessoes sobrevivam a reinicios.
# SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Dados do administrador criado automaticamente na primeira execucao
# (so tem efeito se o banco de dados ainda nao tiver nenhum colaborador cadastrado)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@planosemeador.com.br
ADMIN_SENHA=semeador2026
